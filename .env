# EmailJS settings for the contact form.
# These are *public* browser keys (EmailJS is designed to be called from the
# client), so committing them is fine. Override locally in .env.local.
# If any value is empty, the form falls back to opening the visitor's mail app.
VITE_EMAILJS_PUBLIC_KEY=WfEFXG-uH6eloFg1E
VITE_EMAILJS_SERVICE_ID=service_st7levs
VITE_EMAILJS_TEMPLATE_ID=template_ynu4zll
